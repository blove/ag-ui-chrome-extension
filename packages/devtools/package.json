    "@types/chrome": "^0.2.6",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
