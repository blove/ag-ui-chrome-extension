{
  "name": "ag-ui-devtools-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "package": "pnpm --filter ag-ui-devtools package",
    "test": "pnpm -r run test:ci",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "gen:events": "pnpm -r gen:events",
    "verify:build": "pnpm --filter ag-ui-devtools verify:build",
    "screenshot:panel": "pnpm --filter ag-ui-devtools screenshot:panel",
    "test:e2e": "pnpm --filter ag-ui-harness run test:e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
